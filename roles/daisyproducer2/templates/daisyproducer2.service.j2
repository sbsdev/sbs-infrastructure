{# -*- mode: systemd; -*- #}
[Unit]
Description=Daisy Producer 2
After=network.target

[Service]
Type=exec
ExecStart=/usr/bin/java -Xmx2G -Dconf=/etc/daisyproducer2/config.edn -Dlogback.configurationFile=/etc/daisyproducer2/logback.xml -jar {{daisyproducer2_install_dir}}/daisyproducer2.jar
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
